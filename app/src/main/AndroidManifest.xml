<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.tencent.tim">

    <!--
        minSdk / targetSdk 由 app/build.gradle 统一管理，这里不要再声明 uses-sdk。
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        需要查询游戏是否已安装，以及游戏内的登录组件。
        Android 11+ 不加 queries 会被包可见性拦住，导致 getPackageInfo / resolveActivity 失败。
    -->
    <queries>
        <package android:name="com.tencent.tmgp.dfm" />
        <package android:name="com.tencent.tmgp.pubgmhd" />
        <package android:name="com.tencent.tmgp.sgame" />
        <package android:name="com.tencent.mf.uam" />
        <package android:name="com.tencent.tmgp.codev" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:resizeableActivity="true"
        android:requestLegacyExternalStorage="true"
        tools:ignore="UnusedAttribute">

        <!--
            主页。

            clearTaskOnLaunch="true" 是本轮修复「重启后打开直接进设置页」的关键：
            系统会把上次的任务栈原样恢复（栈顶停在设置页），此时从桌面点图标
            只是把旧任务栈提到前台，于是看到的第一屏就是设置页。
            加上这个属性后，从桌面进入一律先把任务栈清到主页，
            设置页只能从主页点「设置」进入。

            alwaysRetainTaskState="false" 让系统在长时间闲置后不再保留整栈，
            避免恢复出一个和当前配置不符的旧界面。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:clearTaskOnLaunch="true"
            android:alwaysRetainTaskState="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            登录回调界面。

            关键：这里绝对不能写 launchMode="singleTask"。
            Android 明确规定 singleTask / singleInstance 的 Activity 不能作为
            startActivityForResult 的结果目标，一旦使用，
            游戏通过 auth:// 唤起本界面后，本界面的 setResult(RESULT_OK)
            会被系统直接丢弃，游戏永远收不到 token。

            使用 singleTop 即可：重复唤起时复用栈顶，同时保留结果回传能力。
            另外显式声明 taskAffinity 为空串，让本界面尽量落在调用方的任务栈里，
            这样 setResult 才能正确回到游戏。
        -->
        <activity
            android:name="com.tencent.open.agent.AgentActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape">
            <!--
                回调入口 A：官方 auth / qq scheme。
                data 里绝对不能写 android:host —— Android 会把同一个 intent-filter
                内所有 <data> 的属性合并成集合，一旦写了 host，
                其他 scheme 就只认那个 host，tencent<appid>://tauth 会被挡在外面。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="auth" />
                <data android:scheme="qq" />
                <data android:scheme="tencent" />
            </intent-filter>

            <!--
                回调入口 B：真正的 QQ 登录回调是 tencent<appid>://tauth。
                它的 scheme 是 "tencent1110543085" 整串，不是 "tencent"，
                旧的 scheme="tencent" + host="*" 永远匹配不到 ——
                这是「回调根本没进 AgentActivity」的根因。

                Android 的 scheme 不支持通配符，只能按 appid 逐条列。
                新增游戏时在这里补一行。单独一个 filter，避免污染入口 A。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tencent1104466820" />
                <data android:scheme="tencent1110543085" />
                <data android:scheme="tencent1106579570" />
                <data android:scheme="tencent1105207630" />
                <data android:scheme="tencent1105818161" />
                <data android:scheme="tencent1104930057" />
            </intent-filter>
        </activity>

        <!--
            设置页：只有从主页点进来才可能出现。
            deliverResultToCallers 与 isTaskRoot 兜底一起用，
            保证它永远不会成为启动落地页。
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

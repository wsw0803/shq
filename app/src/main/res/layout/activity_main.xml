<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window">
    <ImageView android:id="@+id/bg_custom" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/bg_hue" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <View android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:paddingLeft="18dp" android:paddingRight="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="16dp">
            <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot_green" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="WEI" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:letterSpacing="0.08" />
            <Button android:id="@+id/btn_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:paddingLeft="16dp" android:paddingRight="16dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/card_log" android:layout_width="match_parent" android:layout_height="150dp" android:orientation="vertical" android:background="@drawable/bg_log" android:padding="12dp" android:layout_marginBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="运行日志" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
            <ScrollView android:id="@+id/scroll_log" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical">
                <TextView android:id="@+id/tv_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="> WEI 终端已启动" android:textColor="@color/accent_green" android:textSize="10sp" android:fontFamily="monospace" android:lineSpacingExtra="4dp" />
            </ScrollView>
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="模式" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <RadioGroup android:id="@+id/mode_radio_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:padding="6dp" android:layout_marginBottom="16dp">
                    <RadioButton android:id="@+id/radio_capture_mode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="抓号" android:textColor="@color/text_primary" android:buttonTint="@color/accent_cyan" android:gravity="center" android:padding="10dp" />
                    <RadioButton android:id="@+id/radio_login_mode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="上号" android:textColor="@color/text_primary" android:buttonTint="@color/accent_cyan" android:gravity="center" android:padding="10dp" />
                    <RadioButton android:id="@+id/radio_hang_up_mode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="挂机" android:textColor="@color/text_primary" android:buttonTint="@color/accent_cyan" android:gravity="center" android:padding="10dp" />
                </RadioGroup>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="数据源" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="8dp" android:layout_marginBottom="16dp">
                    <CheckBox android:id="@+id/cb_local_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="本地 appid" android:textColor="@color/text_primary" android:buttonTint="@color/accent_cyan" android:padding="8dp" />
                    <CheckBox android:id="@+id/cb_cloud_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="云端 appid" android:textColor="@color/text_primary" android:buttonTint="@color/accent_cyan" android:padding="8dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_select_game" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择游戏" android:textSize="13sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="14dp" android:layout_marginBottom="10dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/btn_view_token" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="查看 Token" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="12dp" android:layout_marginEnd="5dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开始执行" android:textSize="14sp" android:textStyle="bold" android:textColor="#04121A" android:background="@drawable/glass_btn_primary" android:textAllCaps="false" android:padding="14dp" android:layout_marginBottom="20dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Root 工具" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:padding="10dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btn_hide" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="隐藏 QQ" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginEnd="6dp" android:padding="12dp" />
                    <Button android:id="@+id/btn_show" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="显示 QQ" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginStart="6dp" android:padding="12dp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="存储权限" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="10dp">
                    <TextView android:id="@+id/txt_storage_permission_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● 全文件访问: 已授权" android:textSize="11sp" android:textColor="@color/accent_green" android:fontFamily="monospace" android:layout_marginBottom="6dp" />
                    <TextView android:id="@+id/txt_directory_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● 存储状态: 正常" android:textSize="10sp" android:textColor="@color/text_secondary" android:fontFamily="monospace" android:layout_marginBottom="12dp" />
                    <Button android:id="@+id/btn_select_directory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="配置存储" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面重构版：顶部状态栏 → 模式分段 → 游戏大卡 → 2x2 动作磁贴 → 状态条 → 主操作 → 底部终端。
     配色与玻璃效果沿用原有 color/drawable，仅调整层级顺序与位置。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window">
    <ImageView android:id="@+id/bg_custom" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/bg_hue" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <View android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <!-- 顶栏：状态点 + 字标 + 设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_green" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="WEI"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.16" />
            <TextView
                android:id="@+id/btn_log_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/glass_card"
                android:tag="glass"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/glass_btn_secondary"
                android:tag="glass"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- 模式：三段式选择器 -->
        <RadioGroup
            android:id="@+id/mode_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/glass_card"
            android:tag="glass"
            android:padding="4dp"
            android:layout_marginBottom="12dp">
            <RadioButton
                android:id="@+id/radio_capture_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="抓号"
                android:textSize="12sp"
                android:textColor="@color/seg_text"
                android:button="@null"
                android:background="@drawable/seg_item"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <RadioButton
                android:id="@+id/radio_login_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="上号"
                android:textSize="12sp"
                android:textColor="@color/seg_text"
                android:button="@null"
                android:background="@drawable/seg_item"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <RadioButton
                android:id="@+id/radio_hang_up_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="挂机"
                android:textSize="12sp"
                android:textColor="@color/seg_text"
                android:button="@null"
                android:background="@drawable/seg_item"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </RadioGroup>

        <!-- 中部：游戏大卡 + 动作磁贴 + 状态条 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/btn_select_game"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="选择游戏"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/glass_card"
                    android:tag="glass"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:gravity="center_vertical|start"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <Button
                        android:id="@+id/btn_cloud_appid"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="云端AppID 开"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_card"
                        android:tag="glass"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <Button
                        android:id="@+id/btn_view_token"
                        android:layout_width="0dp"
                        android:layout_height="62dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="查看 Token"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_card"
                        android:tag="glass"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">
                    <Button
                        android:id="@+id/btn_hide"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="隐藏 QQ"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_card"
                        android:tag="glass"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <Button
                        android:id="@+id/btn_show"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="显示 QQ"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_card"
                        android:tag="glass"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/glass_card"
                    android:tag="glass"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txt_storage_permission_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="● 全文件访问: 已授权"
                            android:textSize="10sp"
                            android:textColor="@color/accent_green"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:id="@+id/txt_directory_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="● 存储状态: 正常"
                            android:textSize="10sp"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btn_select_directory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="配置"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_btn_secondary"
                        android:tag="glass"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 主操作：固定在终端上方，拇指区 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="开始执行"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#04121A"
            android:background="@drawable/glass_btn_primary"
            android:tag="glass"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <!-- 底部终端 -->
        <LinearLayout
            android:id="@+id/card_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_log"
            android:tag="glass"
            android:padding="12dp"
            android:layout_marginBottom="6dp">
            <LinearLayout
                android:id="@+id/row_log_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TERMINAL"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.25" />
                <TextView
                    android:id="@+id/tv_log_last"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text=""
                    android:textSize="9sp"
                    android:textColor="@color/accent_green"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="start" />
                <TextView
                    android:id="@+id/tv_log_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开"
                    android:textSize="9sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="monospace" />
            </LinearLayout>
            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:layout_marginTop="6dp"
                android:scrollbars="vertical">
                <TextView
                    android:id="@+id/tv_log"
                    android:fontFeatureSettings="tnum"
                    android:breakStrategy="balanced"
                    android:hyphenationFrequency="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="> WEI 终端已启动"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

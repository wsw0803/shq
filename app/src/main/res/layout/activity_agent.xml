<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ImageView
        android:id="@+id/bg_custom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/bg_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="false"
        android:focusable="false" />

    <View
        android:id="@+id/bg_hue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:clickable="false"
        android:focusable="false" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="18dp">

            <!-- 顶栏：标识 + 关闭 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEI"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.16" />

                <TextView
                    android:id="@+id/btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/glass_card"
                    android:tag="glass" />
            </LinearLayout>

            <!-- 模式说明卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card"
                android:tag="glass"
                android:padding="16dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上号模式"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="粘贴回调链接，或直接执行登录"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="token 只会写进本机存档，不会上传"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 输入区标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTH 链接"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/plain_text"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:gravity="top|start"
                android:hint="auth://tauth.qq.com/?#access_token=..."
                android:background="@drawable/bg_input_state"
                android:padding="14dp"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:inputType="textMultiLine|textNoSuggestions"
                android:maxLines="8"
                android:layout_marginBottom="12dp" />

            <!-- 主要动作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_paste"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="粘贴"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/glass_card"
                    android:tag="glass"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_manual_login"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="执行登录"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#04121A"
                    android:background="@drawable/glass_btn_primary"
                    android:tag="glass"
                    android:textAllCaps="false"
                    android:stateListAnimator="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_pick_token"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="选择 Token 登录"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/glass_card"
                android:tag="glass"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="支持 auth://tauth.qq.com/?#access_token=…&amp;openid=…"
                android:textSize="9sp"
                android:textColor="@color/text_muted"
                android:fontFamily="monospace"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>

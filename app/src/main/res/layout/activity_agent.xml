<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="0dp">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="极光终端"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00D4FF"
                android:fontFamily="monospace"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="> Token 注入模式"
                android:textSize="10sp"
                android:textColor="#8B9DC3"
                android:fontFamily="monospace"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/plain_text"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="top"
                android:hint="auth://tauth.qq.com/?#access_token=..."
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="#FFFFFF"
                android:textColorHint="#8B9DC3"
                android:maxLines="6"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btn_paste"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="> 粘贴登录"
                    android:textSize="12sp"
                    android:textColor="#00D4FF"
                    android:background="@drawable/bg_button_secondary"
                    android:layout_marginRight="8dp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btn_manual_login"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="> 执行登录"
                    android:textSize="12sp"
                    android:textColor="#0A0F1A"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginLeft="8dp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="> 提示: 复制 auth:// 链接后点击「粘贴登录」"
                android:textSize="9sp"
                android:textColor="#8B9DC3"
                android:fontFamily="monospace" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_custom" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/bg_hue" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <View android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:paddingLeft="18dp" android:paddingRight="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="16dp">
            <Button android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="返回" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:paddingLeft="16dp" android:paddingRight="16dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="设置" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示 · DPI" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:tag="glass" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DPI: 100%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150" android:progress="50" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="玻璃效果" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:tag="glass" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="玻璃透明度: 40%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="40" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景亮暗" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:tag="glass" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_bright" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="亮度: 70%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_bright" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="70" android:progressTint="@color/accent_amber" android:thumbTint="@color/accent_amber" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自定义背景" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:tag="glass" android:padding="8dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btn_pick_bg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="选择图片" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="12dp" />
                    <Button android:id="@+id/btn_clear_bg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="清除图片" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="12dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="网络 · 更新代理" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:tag="glass" android:padding="8dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btn_proxy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更新代理: 未设置" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="首次下载 xray 核心时需要能连外网。若已装 Clash 等本地代理，填 127.0.0.1:7890 可完成引导。留空则直连。" android:textSize="10sp" android:textColor="@color/text_muted" android:paddingLeft="4dp" android:paddingRight="4dp" android:paddingTop="6dp" android:paddingBottom="4dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="诊断日志" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:tag="glass" android:padding="12dp" android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="持续抓取日志" android:textSize="13sp" android:textColor="@color/text_primary" />
                        <Switch android:id="@+id/sw_diag" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="开启后持续记录：抓号 / 上号 / 数据写入 / 导出 的全过程，便于定位问题。关闭后不产生任何记录。" android:textSize="10sp" android:textColor="@color/text_muted" android:paddingTop="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <Button android:id="@+id/btn_diag_export" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="导出日志" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="10dp" />
                        <Button android:id="@+id/btn_diag_clear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="清空日志" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="10dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="主题模式" android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/th_dark" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="12dp" android:text="深色" />
                    <Button android:id="@+id/th_light" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="12dp" android:text="浅色" />
                    <Button android:id="@+id/th_auto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="12dp" android:text="跟随系统" />
                </LinearLayout>
                <Button android:id="@+id/btn_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="恢复默认" android:textSize="13sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:tag="glass" android:textAllCaps="false" android:padding="14dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

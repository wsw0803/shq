<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window">
    <View android:id="@+id/bg_hue" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:paddingLeft="18dp" android:paddingRight="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="16dp">
            <Button android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="返回" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:paddingLeft="16dp" android:paddingRight="16dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="设置" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" android:letterSpacing="0.05" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="外观 · DPI" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前 DPI: 100%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="160" android:progress="60" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="外观 · 玻璃效果" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="玻璃强度: 50%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景色度" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_hue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="色相: 0°" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_hue" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="360" android:progress="0" android:progressTint="@color/accent_purple" android:thumbTint="@color/accent_purple" />
                    <TextView android:id="@+id/tv_hue_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="色度浓度: 30%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginTop="14dp" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_hue_alpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="30" android:progressTint="@color/accent_purple" android:thumbTint="@color/accent_purple" />
                </LinearLayout>
                <Button android:id="@+id/btn_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="恢复默认" android:textSize="13sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="14dp" android:layout_marginBottom="10dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg_custom" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
    <View android:id="@+id/bg_hue" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <View android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:paddingLeft="18dp" android:paddingRight="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="16dp">
            <Button android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="返回" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:paddingLeft="16dp" android:paddingRight="16dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="设置" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示 · DPI" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DPI: 100%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_dpi" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="150" android:progress="50" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="玻璃效果" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="玻璃透明度: 40%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_glass" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="40" android:progressTint="@color/accent_cyan" android:thumbTint="@color/accent_cyan" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景亮暗" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/glass_card" android:padding="14dp" android:layout_marginBottom="16dp">
                    <TextView android:id="@+id/tv_bright" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="亮度: 70%" android:textSize="12sp" android:textColor="@color/text_primary" android:fontFamily="monospace" android:layout_marginBottom="8dp" />
                    <SeekBar android:id="@+id/seek_bright" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="70" android:progressTint="@color/accent_amber" android:thumbTint="@color/accent_amber" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="背景样式" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:padding="8dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/bg_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="深海" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="12dp" />
                    <Button android:id="@+id/bg_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="森林" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="12dp" />
                    <Button android:id="@+id/bg_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="紫夜" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="12dp" />
                    <Button android:id="@+id/bg_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="纯黑" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="12dp" />
                </LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="自定义背景" style="@style/SectionLabel" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/glass_card" android:padding="8dp" android:layout_marginBottom="16dp">
                    <Button android:id="@+id/btn_pick_bg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="选择图片" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:layout_marginEnd="4dp" android:padding="12dp" />
                    <Button android:id="@+id/btn_clear_bg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="清除图片" android:textSize="12sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="12dp" />
                </LinearLayout>
                <Button android:id="@+id/btn_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="恢复默认" android:textSize="13sp" android:textColor="@color/text_primary" android:background="@drawable/glass_btn_secondary" android:textAllCaps="false" android:padding="14dp" android:layout_marginBottom="10dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：默认无边框，仅靠填充分层；聚焦时双环咬合 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- 外环：宽而淡的光晕，做温润扩散 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0A2B6CF6" />
                    <corners android:radius="26dp" />
                </shape>
            </item>
            <!-- 内层：实底 + 一圈细咬合线 -->
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#26FFFFFF" />
                    <corners android:radius="23dp" />
                    <stroke android:width="1dp" android:color="#5C2B6CF6" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>

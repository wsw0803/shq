<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作按钮：46dp 高配 14dp 圆角，收成圆角矩形而不是胶囊。
     渐变更深一点在上、亮一点在下，视觉上比纯色薄一档。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF3F82FF"
        android:endColor="#FF2B6CF6"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
